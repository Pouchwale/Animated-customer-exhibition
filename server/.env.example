# PostgreSQL connection. `npm run db` starts an embedded Postgres on port 5433 for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pouchwale
PORT=4000
NODE_ENV=development
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# First admin account, created by the seed. This file is public (committed to Git): never put a real password here.
# start.bat replaces this placeholder with a random password on first run; on a server, set your own (12+ characters).
ADMIN_EMAIL=admin@pouchwale.com
ADMIN_PASSWORD=replace-with-your-own-strong-password
# Suggestion engine: priority-weighted (only option today; AI providers can be added later)
RECOMMENDER=priority-weighted
# Built client served by the API in production
CLIENT_DIST=../client/dist

# --- Network & runtime (optional: blank or missing = the default) ---
# Address the API listens on. Default 127.0.0.1 in development (iPads reach it through the web app's /api proxy),
# 0.0.0.0 (all network interfaces) in production.
HOST=
# Is the site served over HTTPS (directly or by a proxy in front)? Turns on HSTS, CSP upgrade-insecure-requests and
# Secure session cookies. Default true in production, false otherwise. Set HTTPS=false for a production build served
# over plain http:// on a local network, or sign-in will not work.
HTTPS=
# Proxies in front of the API whose X-Forwarded-For is believed (for the client IP in rate limits): a hop count (1 = one
# proxy), true/false, or a comma-separated list of addresses/subnets (e.g. 10.0.0.0/8,loopback). Default 1 in
# production, false otherwise. Avoid "true": anyone could then fake their IP.
TRUST_PROXY=
# Idle keep-alive and request-header timeouts in milliseconds. Keep them above your load balancer's idle timeout;
# HEADERS_TIMEOUT_MS must be greater than KEEP_ALIVE_TIMEOUT_MS.
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000
# Keep-alive ping for Render's free plan (which sleeps after 15 minutes without visitors): the server requests its own
# /api/health every KEEP_ALIVE_MINUTES (1–14). On by itself on Render (it uses RENDER_EXTERNAL_URL, which Render sets);
# off when not on Render. Set KEEP_ALIVE_URL to your own domain to ping that instead, or to false to turn it off.
KEEP_ALIVE_URL=
KEEP_ALIVE_MINUTES=10
