{
  "name": "@pw/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db": "tsx scripts/embedded-db.ts",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:wait": "tsx scripts/wait-for-db.ts && npm run setup && npm run dev",
    "build": "prisma generate && tsup",
    "start": "node dist/index.js",
    "seed:prod": "node dist/seed.js",
    "release": "prisma migrate deploy && node dist/seed.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:integration": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@pw/shared": "1.0.0",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "embedded-postgres": "17.11.0-beta.19",
    "pg": "8.23.1",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsup": "8.5.0",
    "tsx": "4.20.6"
  }
}
