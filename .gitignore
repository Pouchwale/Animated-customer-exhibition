# PouchWale configurator: keep secrets, local data and generated files out of Git.
# Source code, Prisma migrations (*.sql under server/prisma/migrations), client/public assets, package-lock.json,
# start.bat and server/.env.example ARE meant to be committed.

# ---- Environment files and secrets -------------------------------------------------------
.env
.env.*
*.env
!.env.example
!**/.env.example
.envrc
secrets/
*.secret
*.secrets
credentials*.json
service-account*.json
.npmrc
.yarnrc.yml

# ---- Certificates and private keys -------------------------------------------------------
*.pem
*.key
*.crt
*.cer
*.der
*.csr
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# ---- Databases, backups and dumps (local company data) -----------------------------------
# Embedded Postgres data folder (the live dev database).
server/.pgdata/
# Copies of the database and data exports made before migrations.
server/backups/
backups/
*.dump
*.sql.gz
*.backup
*.bak
*.db
*.sqlite
*.sqlite3
# Throwaway Postgres folders from the integration tests (normally in the OS temp folder).
pw-itest-*/

# ---- Dependencies ------------------------------------------------------------------------
node_modules/
.pnpm-store/

# ---- Build output ------------------------------------------------------------------------
dist/
build/
*.tsbuildinfo
.vite/
.cache/

# ---- Logs, test output and temporary files -----------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.nyc_output/
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~
*.orig
*.old

# ---- Uploads and user-generated private files --------------------------------------------
uploads/
storage/

# ---- Editors and IDEs --------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
# Claude Code folder: personal settings, and the PouchWale design-system skill (brand files, brochure pages with
# client names, sales copy). Kept on this computer only: the repository is public. The app's own copies of the logos
# and pouch images are in client/public.
.claude/

# ---- Operating system files --------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
